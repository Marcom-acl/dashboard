# ════════════════════════════════════════════════════════════════
# Dashboard Marcom — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# Ne JAMAIS committer le fichier .env
# ════════════════════════════════════════════════════════════════

# ── Anthropic (IA Insights, Veille) ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Obligatoire si la clé API n'est pas scopée à un workspace (clé admin/org)
# Trouver l'ID sur console.anthropic.com → Settings → Workspaces
ANTHROPIC_WORKSPACE_ID=

# ── Brevo (Email, Contacts, Club) ────────────────────────────────
BREVO_API_KEY=xkeysib-...
# Regex pour identifier les templates newsletter du Club (ex: "club" dans le nom)
NL_CLUB_PATTERN=club

# ── Wrike (Gestion de projet — datacenter EU) ────────────────────
WRIKE_API_KEY=...

# ── Facebook / Meta ──────────────────────────────────────────────
FB_APP_ID=...
FB_APP_SECRET=...
# Token long-lived (60 jours) — se renouvelle automatiquement via /fb/reconnect
FB_TOKEN=...

# ── Google OAuth2 (GA4 + Google Search Console) ──────────────────
# Obtenir depuis Google Cloud Console → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
# Token de rafraîchissement initial (obtenu une fois via le flow OAuth)
GOOGLE_REFRESH_TOKEN=...

# ── Google APIs ───────────────────────────────────────────────────
# Clé API pour PageSpeed Insights (Google Cloud Console → APIs → PageSpeed Insights API)
GOOGLE_API_KEY=...

# ── LinkedIn / Supermetrics ──────────────────────────────────────
LI_CLIENT_ID=...
LI_CLIENT_SECRET=...
LI_ORGANIZATION_ID=...
# Clé API Supermetrics pour les données LinkedIn Analytics
SUPERMETRICS_API_KEY=...

# ── Buffer (Planification sociale) ───────────────────────────────
BUFFER_API_KEY=...
# ID de l'organisation Buffer (optionnel : détecté automatiquement si vide)
BUFFER_ORG_ID=

# ── DataForSEO (Positions SEO + SERP Intelligence) ───────────────
# Format: Base64("login:password") — générer avec :
#   python -c "import base64; print(base64.b64encode(b'login:password').decode())"
DATAFORSEO_AUTH=...
# Alternative si les scripts locaux utilisent login/password séparés :
DATAFORSEO_LOGIN=...
DATAFORSEO_PASSWORD=...

# ── GitHub / Gist (Persistance des tokens OAuth) ─────────────────
# Token GitHub avec scope "gist" uniquement
GITHUB_TOKEN=ghp_...
# ID du Gist qui stocke les tokens OAuth (créer un Gist privé vide au préalable)
GIST_ID=...

# ── Sécurité interne ─────────────────────────────────────────────
# Secret Flask pour les sessions (générer avec : python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET=...
# Token pour les routes de debug (même commande de génération)
INTERNAL_TOKEN=...
# Token pour l'ingestion de données veille via POST /veille/ingest et /veille-ia/ingest
VEILLE_INGEST_TOKEN=...
# Utilisateurs du dashboard, en JSON (liste d'objets avec au moins "email").
# Repli uniquement : la source principale est le Gist (GIST_ID).
DASHBOARD_USERS=[]

# ── Configuration de l'app ───────────────────────────────────────
APP_URL=https://your-app.railway.app
FRONTEND_URL=https://marketing.acl.lu
DATA_DIR=/data
PORT=5050

# ── Application mobile MyACL ─────────────────────────────────────
# Apple App Store Connect — clé API (Utilisateurs et accès → Intégrations → Clés)
ASC_ISSUER_ID=...
# Key ID à 10 caractères (ex : AB12CD34EF)
ASC_KEY_ID=...
# Contenu du fichier .p8 sur une seule ligne, \\n à la place des sauts de ligne
# Ex : -----BEGIN PRIVATE KEY-----\\nMIGH...\\n-----END PRIVATE KEY-----
ASC_PRIVATE_KEY=...
# ID numérique Apple (App Store Connect → App Information → Apple ID, ex : 1234567890)
ASC_APP_ID=...
# Numéro vendeur 8 chiffres (App Store Connect → Paiements → Tous les revenus → colonne Vendeur)
ASC_VENDOR_NUMBER=...

# Google Play Console — compte de service (lecture seule)
# Coller le contenu JSON complet du fichier .json du compte de service, minifié sur une ligne
GPLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\\n...\\n-----END RSA PRIVATE KEY-----\\n","client_email":"dashboard-marcom-reports@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
# URI Cloud Storage (Play Console → Télécharger les rapports → Copier l'URI Cloud Storage)
GPLAY_BUCKET_URI=gs://pubsite_prod_XXXXXXXXXX
# Package name de l'application (ex : lu.acl.myacl)
GPLAY_PACKAGE_NAME=lu.acl.myacl

# ── Optionnel ────────────────────────────────────────────────────
# Désactiver la vérification SSL (proxy Zscaler entreprise)
DISABLE_SSL_VERIFY=false
# Activer le mode debug Flask (ne jamais mettre true en production)
FLASK_DEBUG=false
